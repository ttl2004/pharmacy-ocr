# ---- API service
# Khoá bảo vệ API (header X-API-Key). Để trống = không kiểm tra. Streamlit dùng chung biến này khi gọi service.
OCR_SERVICE_API_KEY=
# Địa chỉ service, dùng cho giao diện Streamlit
OCR_SERVICE_URL=http://127.0.0.1:8000

# ---- LLM (DeepSeek) - bắt buộc
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=180

# ---- Google Cloud Vision - cho engine "vision"
# Lấy key: Google Cloud Console -> bật Billing -> bật Cloud Vision API -> Credentials -> API key (bắt đầu bằng AIza)
GOOGLE_VISION_API_KEY=
VISION_TIMEOUT=60

# ---- OCR local
# Số luồng CPU (0 = tự chọn: một nửa số luồng, tối đa 4). Đặt bằng số nhân thật của máy chạy.
OCR_THREADS=0
# oneDNN cho Paddle: thường nhanh hơn nhiều, nhưng có CPU (nhân E của Intel) bị chậm -> đặt false
OCR_ENABLE_MKLDNN=true
# Cạnh dài ảnh đưa vào detection: 1600 chính xác (~8.7s) | 1280 (~7s) | 960 nhanh (~5s, kém hơn ~4.6 điểm)
OCR_DET_LIMIT_SIDE=1600
# Thư mục model VietOCR (tự tải lần đầu). Có thể trỏ tới thư mục models của project OCR để khỏi tải lại.
MODELS_DIR=

# ---- Engine OCR mặc định: vision | local
OCR_ENGINE=vision

# ---- Worker (hàng đợi trong tiến trình)
WORKER_COUNT=1
WORKER_POLL_SECONDS=1.0

# ---- Ảnh tải lên
MAX_IMAGES=20
MAX_IMAGE_MB=5
# Cạnh dài tối đa sau khi tối ưu (webp)
IMAGE_MAX_SIDE=2400
IMAGE_QUALITY=85

# ---- Tách đoạn theo tiêu đề (tắt mặc định)
SECTION_SPLIT_ENABLED=false
SECTION_MIN_FOUND=3

# ---- Feedback: độ tương đồng tối thiểu để coi là sửa nhẹ
MINOR_EDIT_THRESHOLD=0.9

# ---- Dữ liệu (mặc định: thư mục data/ của project)
# DATA_DIR=
# DB_PATH=        (mặc định DATA_DIR/ocr_service.db)
# STORAGE_DIR=    (mặc định DATA_DIR/extractions)
